[
 {
  "inizio": "Chi dorme",
  "fine": "non piglia pesci",
  "sbagliate": [
   "vive cent'anni",
   "mangia sempre bene"
  ]
 },
 {
  "inizio": "Meglio tardi",
  "fine": "che mai",
  "sbagliate": [
   "che subito",
   "che niente"
  ]
 },
 {
  "inizio": "L'appetito",
  "fine": "vien mangiando",
  "sbagliate": [
   "vien dormendo",
   "vien camminando"
  ]
 },
 {
  "inizio": "Chi va piano",
  "fine": "va sano e va lontano",
  "sbagliate": [
   "non arriva mai",
   "arriva sempre tardi"
  ]
 },
 {
  "inizio": "A caval donato",
  "fine": "non si guarda in bocca",
  "sbagliate": [
   "non si toglie la sella",
   "non si dà l'avena"
  ]
 },
 {
  "inizio": "Il lupo perde il pelo",
  "fine": "ma non il vizio",
  "sbagliate": [
   "ma non la strada",
   "ma non la fame"
  ]
 },
 {
  "inizio": "Can che abbaia",
  "fine": "non morde",
  "sbagliate": [
   "non dorme",
   "non mangia"
  ]
 },
 {
  "inizio": "Chi trova un amico",
  "fine": "trova un tesoro",
  "sbagliate": [
   "trova un guaio",
   "trova una strada"
  ]
 },
 {
  "inizio": "Non è tutto oro",
  "fine": "quel che luccica",
  "sbagliate": [
   "quel che pesa",
   "quel che costa"
  ]
 },
 {
  "inizio": "Rosso di sera",
  "fine": "bel tempo si spera",
  "sbagliate": [
   "pioggia sicura",
   "si va a dormire"
  ]
 },
 {
  "inizio": "Tra il dire e il fare",
  "fine": "c'è di mezzo il mare",
  "sbagliate": [
   "c'è di mezzo un fiume",
   "non c'è mai niente"
  ]
 },
 {
  "inizio": "Chi ben comincia",
  "fine": "è a metà dell'opera",
  "sbagliate": [
   "ha già finito",
   "non finisce mai"
  ]
 },
 {
  "inizio": "Una rondine",
  "fine": "non fa primavera",
  "sbagliate": [
   "porta il bel tempo",
   "fa un bel nido"
  ]
 },
 {
  "inizio": "Ogni lasciata",
  "fine": "è persa",
  "sbagliate": [
   "è guadagnata",
   "è ritrovata"
  ]
 },
 {
  "inizio": "Chi fa da sé",
  "fine": "fa per tre",
  "sbagliate": [
   "fa per due",
   "non fa niente"
  ]
 },
 {
  "inizio": "Il mattino",
  "fine": "ha l'oro in bocca",
  "sbagliate": [
   "ha l'argento in tasca",
   "ha il sole in testa"
  ]
 },
 {
  "inizio": "Ogni scarafaggio",
  "fine": "è bello per la sua mamma",
  "sbagliate": [
   "è nemico della casa",
   "scappa alla luce"
  ]
 },
 {
  "inizio": "Deve passare",
  "fine": "la nottata",
  "sbagliate": [
   "la tempesta",
   "la giornata"
  ]
 },
 {
  "inizio": "Con la bocca chiusa",
  "fine": "non entrano mosche",
  "sbagliate": [
   "non si dice niente",
   "si mangia meglio"
  ]
 },
 {
  "inizio": "L'amico è come l'ombrello:",
  "fine": "quando piove non lo trovi mai",
  "sbagliate": [
   "si apre sempre al sole",
   "si perde subito"
  ]
 },
 {
  "inizio": "I soldi",
  "fine": "fanno tornare la vista ai ciechi",
  "sbagliate": [
   "crescono sugli alberi",
   "si trovano per strada"
  ]
 },
 {
  "inizio": "Meglio arrossire una volta",
  "fine": "che sbiancare cento volte",
  "sbagliate": [
   "che ridere sempre",
   "che parlare troppo"
  ]
 },
 {
  "inizio": "Chi pecora si fa",
  "fine": "il lupo se la mangia",
  "sbagliate": [
   "trova sempre un pastore",
   "dorme tranquillo"
  ]
 },
 {
  "inizio": "La gatta per la fretta",
  "fine": "fece i gattini ciechi",
  "sbagliate": [
   "perse la strada di casa",
   "non mangiò più"
  ]
 },
 {
  "inizio": "Più la testa è vuota",
  "fine": "più la lingua è lunga",
  "sbagliate": [
   "più il cuore è grande",
   "più il passo è corto"
  ]
 },
 {
  "inizio": "La parola migliore",
  "fine": "è quella che non si dice",
  "sbagliate": [
   "è quella detta per prima",
   "è quella detta più forte"
  ]
 },
 {
  "inizio": "Chi ha il pane",
  "fine": "non ha i denti",
  "sbagliate": [
   "ha sempre fame",
   "è fortunato"
  ]
 },
 {
  "inizio": "Quando il letto è stretto,",
  "fine": "mettiti in mezzo",
  "sbagliate": [
   "stendi una coperta",
   "cambia stanza"
  ]
 },
 {
  "inizio": "Natale con i tuoi,",
  "fine": "Pasqua con chi vuoi",
  "sbagliate": [
   "Capodanno con gli amici",
   "Carnevale in famiglia"
  ]
 },
 {
  "inizio": "Fidarsi è bene,",
  "fine": "non fidarsi è meglio",
  "sbagliate": [
   "ridere è meglio",
   "aspettare è meglio"
  ]
 },
 {
  "inizio": "Chi si fa i fatti suoi",
  "fine": "campa cent'anni",
  "sbagliate": [
   "non trova amici",
   "mangia sempre bene"
  ]
 },
 {
  "inizio": "A tavola",
  "fine": "non si invecchia",
  "sbagliate": [
   "si parla poco",
   "si sta in piedi"
  ]
 },
 {
  "inizio": "Una mano",
  "fine": "lava l'altra",
  "sbagliate": [
   "scrive meglio",
   "tiene l'ombrello"
  ]
 },
 {
  "inizio": "Chi semina vento",
  "fine": "raccoglie tempesta",
  "sbagliate": [
   "raccoglie grano",
   "raccoglie fiori"
  ]
 },
 {
  "inizio": "Cu 'e chiacchiere",
  "fine": "nun se fanno 'e frittelle",
  "sbagliate": [
   "se fa 'o ragù",
   "se fa notte"
  ]
 },
 {
  "inizio": "Chi nasce tunno",
  "fine": "nun pò murì quadrato",
  "sbagliate": [
   "more cuntento",
   "campa cient'anne"
  ]
 },
 {
  "inizio": "'O pesce fète",
  "fine": "d' 'a capa",
  "sbagliate": [
   "d' 'a coda",
   "quanno chiove"
  ]
 },
 {
  "inizio": "Addò ce sta gusto",
  "fine": "nun ce sta perdenza",
  "sbagliate": [
   "ce sta 'o mare",
   "ce sta 'a festa"
  ]
 },
 {
  "inizio": "Pure 'e pulce",
  "fine": "tènono 'a tosse",
  "sbagliate": [
   "vanno a mare",
   "cantano 'a sera"
  ]
 },
 {
  "inizio": "Chi va pe' chisti mare",
  "fine": "chisti pisce piglia",
  "sbagliate": [
   "se perde 'a strada",
   "torna 'a casa"
  ]
 },
 {
  "inizio": "Nun c'è sabato",
  "fine": "senza sole",
  "sbagliate": [
   "senza ragù",
   "senza pioggia"
  ]
 },
 {
  "inizio": "Quanno 'o diavulo t'accarezza",
  "fine": "vò ll'anema",
  "sbagliate": [
   "te porta 'o ccafè",
   "vò fa pace"
  ]
 },
 {
  "inizio": "'A lengua nun tene ossa",
  "fine": "ma rompe ll'osse",
  "sbagliate": [
   "e nun parla",
   "ma fa male 'e diente"
  ]
 },
 {
  "inizio": "Chi tene 'a mamma",
  "fine": "nun chiagne",
  "sbagliate": [
   "nun dorme",
   "mangia buono"
  ]
 },
 {
  "inizio": "Tre so' 'e putiente:",
  "fine": "'o Papa, 'o Re e chi nun tene niente",
  "sbagliate": [
   "'o sole, 'a luna e 'o mare",
   "'o pate, 'a mamma e 'o figlio"
  ]
 },
 {
  "inizio": "Chi la fa",
  "fine": "l'aspetti",
  "sbagliate": [
   "la mangia",
   "la vende"
  ]
 },
 {
  "inizio": "Paese che vai",
  "fine": "usanza che trovi",
  "sbagliate": [
   "amico che perdi",
   "casa che lasci"
  ]
 },
 {
  "inizio": "Chi tace",
  "fine": "acconsente",
  "sbagliate": [
   "dorme bene",
   "non sbaglia mai"
  ]
 },
 {
  "inizio": "Il buon giorno",
  "fine": "si vede dal mattino",
  "sbagliate": [
   "si dice alla sera",
   "porta la pioggia"
  ]
 },
 {
  "inizio": "Moglie e buoi",
  "fine": "dei paesi tuoi",
  "sbagliate": [
   "in campagna",
   "al mercato"
  ]
 },
 {
  "inizio": "Chi troppo vuole",
  "fine": "nulla stringe",
  "sbagliate": [
   "tutto mangia",
   "presto si stanca"
  ]
 },
 {
  "inizio": "Occhio non vede,",
  "fine": "cuore non duole",
  "sbagliate": [
   "mano non tocca",
   "bocca non parla"
  ]
 },
 {
  "inizio": "Chi cerca",
  "fine": "trova",
  "sbagliate": [
   "si stanca",
   "si perde"
  ]
 },
 {
  "inizio": "Tutto è bene",
  "fine": "quel che finisce bene",
  "sbagliate": [
   "quel che costa poco",
   "quel che si mangia"
  ]
 },
 {
  "inizio": "Sbagliando",
  "fine": "s'impara",
  "sbagliate": [
   "si piange",
   "si dorme"
  ]
 },
 {
  "inizio": "L'erba del vicino",
  "fine": "è sempre più verde",
  "sbagliate": [
   "non si taglia mai",
   "è sempre bagnata"
  ]
 },
 {
  "inizio": "Anno nuovo,",
  "fine": "vita nuova",
  "sbagliate": [
   "casa nuova",
   "scarpe nuove"
  ]
 },
 {
  "inizio": "Ride bene",
  "fine": "chi ride ultimo",
  "sbagliate": [
   "chi mangia tanto",
   "chi dorme poco"
  ]
 },
 {
  "inizio": "Dimmi con chi vai",
  "fine": "e ti dirò chi sei",
  "sbagliate": [
   "e ti dirò dove abiti",
   "e ti offrirò un caffè"
  ]
 },
 {
  "inizio": "Meglio un uovo oggi",
  "fine": "che una gallina domani",
  "sbagliate": [
   "che una frittata stasera",
   "che un pulcino ieri"
  ]
 },
 {
  "inizio": "Gallina vecchia",
  "fine": "fa buon brodo",
  "sbagliate": [
   "non fa più uova",
   "canta la mattina"
  ]
 },
 {
  "inizio": "Patti chiari,",
  "fine": "amicizia lunga",
  "sbagliate": [
   "conti salati",
   "porta aperta"
  ]
 }
]