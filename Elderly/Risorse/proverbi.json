[
 {
  "inizio": "Chi dorme",
  "fine": "non piglia pesci",
  "sbagliate": [
   "vive cent'anni",
   "mangia sempre bene"
  ]
 },
 {
  "inizio": "Meglio tardi",
  "fine": "che mai",
  "sbagliate": [
   "che subito",
   "che niente"
  ]
 },
 {
  "inizio": "L'appetito",
  "fine": "vien mangiando",
  "sbagliate": [
   "vien dormendo",
   "vien camminando"
  ]
 },
 {
  "inizio": "Chi va piano",
  "fine": "va sano e va lontano",
  "sbagliate": [
   "non arriva mai",
   "arriva sempre tardi"
  ]
 },
 {
  "inizio": "A caval donato",
  "fine": "non si guarda in bocca",
  "sbagliate": [
   "non si toglie la sella",
   "non si dà l'avena"
  ]
 },
 {
  "inizio": "Il lupo perde il pelo",
  "fine": "ma non il vizio",
  "sbagliate": [
   "ma non la strada",
   "ma non la fame"
  ]
 },
 {
  "inizio": "Can che abbaia",
  "fine": "non morde",
  "sbagliate": [
   "non dorme",
   "non mangia"
  ]
 },
 {
  "inizio": "Chi trova un amico",
  "fine": "trova un tesoro",
  "sbagliate": [
   "trova un guaio",
   "trova una strada"
  ]
 },
 {
  "inizio": "Non è tutto oro",
  "fine": "quel che luccica",
  "sbagliate": [
   "quel che pesa",
   "quel che costa"
  ]
 },
 {
  "inizio": "Rosso di sera",
  "fine": "bel tempo si spera",
  "sbagliate": [
   "pioggia sicura",
   "si va a dormire"
  ]
 },
 {
  "inizio": "Tra il dire e il fare",
  "fine": "c'è di mezzo il mare",
  "sbagliate": [
   "c'è di mezzo un fiume",
   "non c'è mai niente"
  ]
 },
 {
  "inizio": "Chi ben comincia",
  "fine": "è a metà dell'opera",
  "sbagliate": [
   "ha già finito",
   "non finisce mai"
  ]
 },
 {
  "inizio": "Una rondine",
  "fine": "non fa primavera",
  "sbagliate": [
   "porta il bel tempo",
   "fa un bel nido"
  ]
 },
 {
  "inizio": "Ogni lasciata",
  "fine": "è persa",
  "sbagliate": [
   "è guadagnata",
   "è ritrovata"
  ]
 },
 {
  "inizio": "Chi fa da sé",
  "fine": "fa per tre",
  "sbagliate": [
   "fa per due",
   "non fa niente"
  ]
 },
 {
  "inizio": "Il mattino",
  "fine": "ha l'oro in bocca",
  "sbagliate": [
   "ha l'argento in tasca",
   "ha il sole in testa"
  ]
 }
]